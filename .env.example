# 复制为仓库根目录 .env 后再启动：
#   copy .env.example .env
#   docker compose up -d --build

# JWT，生产必须换成随机值，至少 32 位
SECRET_KEY=docker-compose-change-this-secret-key32

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=yostone
MYSQL_PASSWORD=change-me-db-password
MYSQL_DATABASE=yostone_knowledge

REDIS_PASSWORD=change-me-redis-password

# 宿主机端口。容器内后端始终听 8004，前端 nginx 始终听 80
BACKEND_PORT=8004
FRONTEND_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379

# 使用 GitHub Actions CD 推送到 GHCR 的镜像时，在服务器 .env 中取消注释：
# BACKEND_IMAGE=ghcr.io/zhangyichen-ship-it/yaoshizhishiku/backend:latest
# FRONTEND_IMAGE=ghcr.io/zhangyichen-ship-it/yaoshizhishiku/frontend:latest
# PULL_POLICY=always

# 构建时 PyPI，国内可取消注释
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 可选：远程模型（本地 embedding 可留空）
# EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# OPENAI_EMBEDDING_MODEL=

# 可选：云面板绑定（页面绑定成功后优先用数据库里的加密配置）
# KB_CONTROL_PLANE_API_URL=
# KB_CONTROL_PLANE_INSTANCE_ID=0
# KB_CONTROL_PLANE_SERVICE_CREDENTIAL=
